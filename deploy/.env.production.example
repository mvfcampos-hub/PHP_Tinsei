# Modelo de .env para produção na Hostgator (hospedagem compartilhada).
# Copie este arquivo para ".env" na raiz do projeto (mesma pasta do
# artisan), preencha os valores marcados com "PREENCHER" e faça upload.
# NÃO deixe este arquivo (nem o .env final) dentro de public_html.

APP_NAME="CRN-9"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE="America/Sao_Paulo"
APP_URL=https://PREENCHER-seudominio.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Banco de dados MySQL criado em cPanel > MySQL® Databases.
# DB_HOST costuma ser "localhost" quando o site está no mesmo servidor.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=PREENCHER-usuario_crn9
DB_USERNAME=PREENCHER-usuario_crn9
DB_PASSWORD=PREENCHER-senha-forte

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="crn9@crn9.org.br"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Token secreto de uso único para o deploy.php (ver DEPLOY_HOSTGATOR.md).
# Gere o seu próprio valor (não reaproveite este exemplo) com, por
# exemplo: php -r "echo bin2hex(random_bytes(24));"
DEPLOY_SECRET=troque-por-um-valor-aleatorio-e-longo
