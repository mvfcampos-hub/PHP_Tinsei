# Modelo de .env para a hospedagem cPanel (homologação em novo.tinsei.com.br).
# Copie para ".env" na pasta do site e preencha os campos vazios marcados com "PREENCHER".
APP_NAME=Tinsei
APP_ENV=production
# PREENCHER: o pacote já vem com uma chave; sem ela, rode php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
APP_URL=https://novo.tinsei.com.br
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

# Homologação: impede o Google de indexar. Mude para false no domínio definitivo.
SITE_NOINDEX=true

# Uploads do painel direto em public/storage (dispensa o "storage:link").
PUBLIC_STORAGE_IN_WEBROOT=true

LOG_CHANNEL=daily
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
# PREENCHER
DB_DATABASE=
# PREENCHER
DB_USERNAME=
# PREENCHER
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# E-mail (conta criada no cPanel, ex.: site@tinsei.com.br)
MAIL_MAILER=smtp
# PREENCHER
MAIL_HOST=
MAIL_PORT=465
# PREENCHER
MAIL_USERNAME=
# PREENCHER
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=site@tinsei.com.br
MAIL_FROM_NAME="${APP_NAME}"

ADMIN_EMAIL=admin@tinsei.com.br
# PREENCHER
ADMIN_PASSWORD=
