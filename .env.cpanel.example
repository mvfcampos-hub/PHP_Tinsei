# Modelo de .env para a hospedagem cPanel (homologação em novo.tinsei.com.br).
# Copie para ".env" na pasta do site e preencha os campos marcados com <...>.
APP_NAME=Tinsei
APP_ENV=production
APP_KEY=<gerado pelo comando php artisan key:generate, ou use o do pacote>
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
APP_URL=https://novo.tinsei.com.br
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

# Homologação: impede o Google de indexar. Mude para false no domínio definitivo.
SITE_NOINDEX=true

# Uploads do painel direto em public/storage (dispensa o "storage:link").
PUBLIC_STORAGE_IN_WEBROOT=true

LOG_CHANNEL=daily
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<usuariocpanel_tinsei>
DB_USERNAME=<usuariocpanel_tinsei>
DB_PASSWORD=<senha do banco>

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# E-mail (conta criada no cPanel, ex.: site@tinsei.com.br)
MAIL_MAILER=smtp
MAIL_HOST=<mail.tinsei.com.br>
MAIL_PORT=465
MAIL_USERNAME=<site@tinsei.com.br>
MAIL_PASSWORD=<senha do e-mail>
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=site@tinsei.com.br
MAIL_FROM_NAME="${APP_NAME}"

ADMIN_EMAIL=admin@tinsei.com.br
ADMIN_PASSWORD=<senha forte>
